{
  "expo": {
    "name": "LavanderiaPristine",
    "slug": "LavanderiaPristine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite a Lavandería Pristine usar Face ID para desbloquear la sesión local de demostración."
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abelrodrigo.lavanderiapristine"
    },
    "android": {
      "package": "com.abelrodrigo.lavanderiapristine",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
